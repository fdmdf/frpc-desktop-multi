<!--
  `scripts/tauri-android-setup.sh` 第 7 步会把下面两块合并进
  gen/android/app/src/main/AndroidManifest.xml（gen/ 不入库）。这里留一份对照，
  方便审查实际生效的清单。

  不要写 `.service.FrpcService` / `.service.BootReceiver` 这类旧类名 —— 那是 Kotlin 版
  遗留的 service 层，Tauri 版没有这些类，清单里留着会让系统在启动时崩。
-->

<!-- ① 权限（插在 <application> 之前） -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

<!-- ② 前台保活服务（插在 </application> 之前） -->
<service
    android:name="io.github.fdmdf.frpc.service.FrpcKeepAliveService"
    android:exported="false"
    android:foregroundServiceType="dataSync" />
