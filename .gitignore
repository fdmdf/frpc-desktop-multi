# ---- 构建缓存 ----
.build/

# ---- 运行时产物：引擎二进制由 scripts/build-frpc.sh 编译后打入，不入库 ----
tauri/engines/android/jniLibs/*/libfrpc.so

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 签名与密钥（默认不入库）----
*.jks
*.keystore
*.p12
keystore-password.txt
keystore.b64
# 唯一例外：Android 发布签名密钥。必须入库，否则每次 CI 随机生成密钥，
# 用户覆盖安装会报「签名不一致」，只能卸载重装。说明见
# tauri/android-signing/README.md（可在 CI 里用 secrets 覆盖）。
!tauri/android-signing/release.keystore

# ---- 构建输出 ----
dist/
*.apk
*.aab
*.dmg
*.deb
*.AppImage
*.zip
*.tar.gz

# ---- WorkBuddy 本地状态 ----
.workbuddy/tmp/
.workbuddy/memory/
.workbuddy/tmp*

# ---- Tauri / Rust ----
tauri/target/
tauri/app/src-tauri/target/
tauri/app/src-tauri/gen/schemas/
# Android 生成工程（scripts/tauri-android-setup.sh 可一键重建，含镜像/jniLibs 注入）
tauri/app/src-tauri/gen/
tauri/app/src-tauri/resources/engine/
tauri/app/ui/node_modules/
